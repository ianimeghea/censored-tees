# Printify Personal Access Token
# Generate one at: https://printify.com/app/account/api
PRINTIFY_API_TOKEN=your_personal_access_token_here

# Your Printify Shop ID
# Find it by calling GET https://api.printify.com/v1/shops.json
PRINTIFY_SHOP_ID=your_shop_id_here

# Identifies your client to the Printify API (required by Printify)
PRINTIFY_USER_AGENT=PrintifyStorefront

# Supabase / PostgreSQL connection string
# Get it from Supabase → Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.XXXX.supabase.co:5432/postgres

# Flask secret key (used for sessions/flash messages)
FLASK_SECRET_KEY=change_me_to_a_random_string

# PayPal — get these at https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=your_client_id_here
PAYPAL_SECRET=your_secret_here
# Set to "false" for live/production payments
PAYPAL_SANDBOX=

# Public URL the user is redirected back to (e.g. http://127.0.0.1:5000)
APP_BASE_URL=http://127.0.0.1:5000

# Admin login for /admin order log (HTTP basic auth)
ADMIN_USER=admin
ADMIN_PASSWORD=change_me_to_something_strong

# Region-specific product collections (comma-separated Printify product IDs)
# Products not in either list are shown to everyone.
PRODUCTS_RO_ONLY=
PRODUCTS_INT_ONLY=
